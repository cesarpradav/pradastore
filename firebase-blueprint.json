{
  "entities": {
    "phone": {
      "title": "PhoneItem",
      "description": "Serialized iPhone inventory item tracked across eBay, Zoom, and sale in Venezuela",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "model": { "type": "string", "maxLength": 128 },
        "condition": { "type": "string", "maxLength": 64 },
        "storage": { "type": "string", "maxLength": 64 },
        "color": { "type": "string", "maxLength": 64 },
        "imei": { "type": "string", "maxLength": 64 },
        "imei1": { "type": "string", "maxLength": 64 },
        "imei2": { "type": "string", "maxLength": 64 },
        "physicalGrade": { "type": "string", "maxLength": 256 },
        "ebayLink": { "type": "string", "maxLength": 1024 },
        "ebayOrderNumber": { "type": "string", "maxLength": 128 },
        "purchaseDate": { "type": "string", "maxLength": 32 },
        "productCostUsdt": { "type": "number" },
        "usShippingCostUsdt": { "type": "number" },
        "additionalCostUsdt": { "type": "number" },
        "usTrackingNumber": { "type": "string", "maxLength": 128 },
        "usCarrier": { "type": "string", "maxLength": 64 },
        "isPrealerted": { "type": "boolean" },
        "prealertDate": { "type": "string", "maxLength": 32 },
        "zoomTrackingNumber": { "type": "string", "maxLength": 128 },
        "zoomCostStatus": { "type": "string", "enum": ["known", "pending"] },
        "zoomCostBcv": { "type": "number" },
        "isZoomPaid": { "type": "boolean" },
        "zoomPaidAmountBcv": { "type": "number" },
        "zoomPaymentMethod": { "type": "string", "maxLength": 64 },
        "isZoomPickedUp": { "type": "boolean" },
        "zoomPickupDate": { "type": "string", "maxLength": 32 },
        "zoomAgency": { "type": "string", "maxLength": 128 },
        "projectedPriceUsdt": { "type": "number" },
        "status": {
          "type": "string",
          "enum": [
            "en_transito_usa",
            "en_casillero_zoom",
            "en_agencia_zoom",
            "disponible_para_venta",
            "reservado",
            "vendido"
          ]
        },
        "soldPriceUsdt": { "type": "number" },
        "soldDate": { "type": "string", "maxLength": 32 },
        "buyerName": { "type": "string", "maxLength": 128 },
        "buyerPhone": { "type": "string", "maxLength": 64 },
        "buyerIdNumber": { "type": "string", "maxLength": 64 },
        "soldPaymentMethod": { "type": "string", "maxLength": 64 },
        "receiptNumber": { "type": "string", "maxLength": 64 },
        "orderControlNumber": { "type": "string", "maxLength": 64 },
        "batteryHealth": { "type": "number" },
        "accessories": { "type": "string", "maxLength": 256 },
        "warrantyDays": { "type": "number" },
        "notes": { "type": "string", "maxLength": 2048 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": [
        "id",
        "model",
        "condition",
        "ebayLink",
        "purchaseDate",
        "productCostUsdt",
        "additionalCostUsdt",
        "usTrackingNumber",
        "isPrealerted",
        "zoomCostStatus",
        "zoomCostBcv",
        "isZoomPaid",
        "zoomPaidAmountBcv",
        "isZoomPickedUp",
        "projectedPriceUsdt",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "customer": {
      "title": "Customer",
      "description": "Customer registered in the CRM module",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "idNumber": { "type": "string", "maxLength": 64 },
        "fullName": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 64 },
        "email": { "type": "string", "maxLength": 128 },
        "instagram": { "type": "string", "maxLength": 64 },
        "city": { "type": "string", "maxLength": 128 },
        "address": { "type": "string", "maxLength": 256 },
        "notes": { "type": "string", "maxLength": 1024 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "idNumber", "fullName", "phone", "createdAt"]
    },
    "warrantyOrder": {
      "title": "WarrantyOrder",
      "description": "Warranty order / sales delivery certificate",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "controlNumber": { "type": "string", "maxLength": 64 },
        "date": { "type": "string", "maxLength": 32 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 128 },
        "customerIdNumber": { "type": "string", "maxLength": 64 },
        "customerPhone": { "type": "string", "maxLength": 64 },
        "phoneItemId": { "type": "string", "maxLength": 128 },
        "phoneModel": { "type": "string", "maxLength": 128 },
        "storage": { "type": "string", "maxLength": 64 },
        "color": { "type": "string", "maxLength": 64 },
        "imei1": { "type": "string", "maxLength": 64 },
        "imei2": { "type": "string", "maxLength": 64 },
        "batteryHealth": { "type": "number" },
        "physicalGrade": { "type": "string", "maxLength": 256 },
        "accessories": { "type": "string", "maxLength": 256 },
        "amountPaidUsdt": { "type": "number" },
        "amountPaidBs": { "type": "number" },
        "bcvRateUsed": { "type": "number" },
        "binanceRateUsed": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 64 },
        "paymentReference": { "type": "string", "maxLength": 128 },
        "warrantyDays": { "type": "number" },
        "warrantyExpiresDate": { "type": "string", "maxLength": 32 },
        "warrantyTerms": { "type": "string", "maxLength": 4096 },
        "status": { "type": "string", "enum": ["active", "expired", "voided"] },
        "voidReason": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": [
        "id",
        "controlNumber",
        "date",
        "customerName",
        "customerIdNumber",
        "customerPhone",
        "phoneItemId",
        "phoneModel",
        "storage",
        "color",
        "imei1",
        "physicalGrade",
        "accessories",
        "amountPaidUsdt",
        "amountPaidBs",
        "bcvRateUsed",
        "binanceRateUsed",
        "paymentMethod",
        "warrantyDays",
        "warrantyExpiresDate",
        "warrantyTerms",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "sellerProfile": {
      "title": "SellerProfile",
      "description": "Seller profile and commercial warranty terms",
      "type": "object",
      "properties": {
        "sellerName": { "type": "string", "maxLength": 128 },
        "sellerIdNumber": { "type": "string", "maxLength": 64 },
        "sellerPhone": { "type": "string", "maxLength": 64 },
        "storeName": { "type": "string", "maxLength": 128 },
        "instagram": { "type": "string", "maxLength": 64 },
        "cityAddress": { "type": "string", "maxLength": 128 },
        "warrantyTerms": { "type": "string", "maxLength": 4096 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": [
        "sellerName",
        "sellerIdNumber",
        "sellerPhone",
        "storeName",
        "cityAddress",
        "warrantyTerms"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/phones/{phoneId}": {
      "schema": "phone",
      "description": "Phones in user inventory"
    },
    "/users/{userId}/customers/{customerId}": {
      "schema": "customer",
      "description": "Customers in user CRM"
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": "warrantyOrder",
      "description": "Warranty and delivery orders created by user"
    },
    "/users/{userId}/profile/main": {
      "schema": "sellerProfile",
      "description": "User business profile and warranty terms"
    }
  }
}
